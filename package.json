{
  "name": "miyagi",
  "version": "0.1.0",
  "description": "A voice tutor for codebases: ask out loud, and it explains while highlighting the code it talks about.",
  "keywords": [
    "voice",
    "tutor",
    "codebase",
    "code explanation",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssaarthakk/Miyagi.git"
  },
  "license": "AGPL-3.0-only",
  "author": "Sarthak Kumar",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "miyagi": "dist/server/cli.js"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run check",
    "format": "biome check --write .",
    "test": "vitest run --passWithNoTests",
    "check": "biome check . && tsc -p tsconfig.node.json && svelte-check --tsconfig tsconfig.web.json --fail-on-warnings && knip && vitest run --passWithNoTests",
    "check:fast": "biome lint . && tsc -p tsconfig.node.json && svelte-check --tsconfig tsconfig.web.json --fail-on-warnings",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.6.5",
    "codemirror": "6.0.2",
    "knip": "6.42.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@vscode/ripgrep": "1.18.0",
    "ignore": "7.0.12",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "web-tree-sitter": "0.27.1",
    "zod": "4.6.7"
  }
}
